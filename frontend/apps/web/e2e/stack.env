# Окружение стека сквозных тестов.
#
# Секретов здесь нет: значения одноразовые, стек живёт только на время прогона,
# слушает localhost и пересоздаётся с нуля перед каждым запуском.
#
# Файл заменяет корневой .env целиком (см. compose.e2e.yml). Так прогон не
# зависит от того, что разработчик написал у себя: иначе письма ушли бы на его
# SMTP, ссылки указывали бы на его домен, а бот получил бы его настоящий токен.

ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_USER=repibot
POSTGRES_PASSWORD=e2e-postgres
POSTGRES_DB=repibot
DATABASE_URL=postgresql+asyncpg://repibot:e2e-postgres@postgres:5432/repibot

VALKEY_URL=redis://valkey:6379/0

# Бот в сквозных сценариях не участвует, поэтому токен подставной, а сам
# контейнер поднимается пустым — см. compose.e2e.yml.
BOT_TOKEN=0:e2e-bot-token
BOT_WEBHOOK_SECRET=e2e-webhook-secret
BOT_WEBHOOK_BASE_URL=http://localhost:8081
BOT_USE_POLLING=false

REMNAWAVE_BASE_URL=http://remnawave-fake:3000
REMNAWAVE_TOKEN=e2e-remnawave-token
REMNAWAVE_WEBHOOK_SECRET=e2e-remnawave-webhook-secret
ADMIN_TELEGRAM_IDS=

# Контур оплаты целиком локален: API видит подставного провайдера только по
# имени compose-сервиса, Playwright управляет им исключительно через loopback.
YOOKASSA_SHOP_ID=e2e-yookassa-shop
YOOKASSA_SECRET_KEY=e2e-yookassa-secret
YOOKASSA_API_BASE_URL=http://yookassa-fake:3000/v3

# Настройки отвергают ключ подписи короче 32 символов.
JWT_SECRET=e2e-jwt-secret-0123456789abcdef0123456789
ADMIN_ASSERTION_SECRET=e2e-admin-assertion-secret-0123456789
ENCRYPTION_KEY=e2e-encryption-key-0123456789abcdef012345

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ASSERTION_TTL_SECONDS=300
# Письма уходят в Mailpit, тест читает их через его API. С EMAIL_SENDER=log
# сквозной сценарий пришлось бы вычитывать ссылку из журнала контейнера.
EMAIL_SENDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@repibot.test
SMTP_STARTTLS=false

# Этот адрес попадает в ссылки писем, и по нему же ходит браузер теста. Порт
# нестандартный: прогон не должен спорить за 80 с обычным `docker compose up`.
PUBLIC_WEB_URL=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081/app

DEFAULT_LANGUAGE=ru
