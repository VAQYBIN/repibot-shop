# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- База данных ---
# Пароль встречается дважды и значения должны совпадать. Внутри DATABASE_URL
# он часть адреса, поэтому символы @ : / ? # % нужно кодировать: @ → %40,
# : → %3A, % → %25. Проще сгенерировать пароль без них:
#   openssl rand -hex 16
POSTGRES_USER=repibot
POSTGRES_PASSWORD=смените-меня
POSTGRES_DB=repibot
DATABASE_URL=postgresql+asyncpg://repibot:смените-меня@postgres:5432/repibot

# --- Кэш и очередь ---
VALKEY_URL=redis://valkey:6379/0

# --- Telegram ---
# Токен бота выдаёт @BotFather.
BOT_TOKEN=
# Случайная строка. Telegram присылает её в заголовке
# X-Telegram-Bot-Api-Secret-Token, по нему проверяется подлинность запроса.
# В пути вебхука её нет: URL пишется в журналы прокси целиком.
# Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_BASE_URL=https://example.org
# true — long polling для локальной разработки без внешнего адреса.
BOT_USE_POLLING=false

# --- Панель Remnawave ---
# При развёртывании рядом с панелью: http://remnawave:3000
REMNAWAVE_BASE_URL=https://panel.example.org
REMNAWAVE_TOKEN=
# Секрет и заголовок вебхуков панели задаются на её стороне. Пустой секрет
# означает «вебхуки не настроены»: неподписанные события отвергаются, а не
# принимаются на веру. Имя заголовка вынесено в переменную, потому что в схеме
# панели его нет и подтвердить его можно только на живой установке.
# Сгенерировать: openssl rand -hex 32
REMNAWAVE_WEBHOOK_SECRET=
REMNAWAVE_WEBHOOK_HEADER=x-remnawave-signature
# Сколько секунд ждать панель при синхронной выдаче доступа. Короче
# REMNAWAVE_TIMEOUT_SECONDS: пользователь ждёт ответа, а надёжность даёт
# очередь повторов, а не его терпение.
REMNAWAVE_PROVISION_TIMEOUT_SECONDS=3.0
# Сколько секунд живёт кэш справочных данных панели (списки сквадов и лимиты).
# Витрина тарифов иначе дёргает панель на каждый показ.
PANEL_CACHE_TTL_SECONDS=60

# --- Подписки ---
# Сколько устройств пользователь может отвязать за сутки. Десяти хватает при
# смене телефона и переустановке системы; больше — это раздача подписки по кругу.
DEVICE_UNLINK_LIMIT_PER_DAY=10
# true — при смене тарифа остаток текущего переезжает в новый днями по
# стоимости дня. false — остаток сгорает.
PLAN_CHANGE_KEEPS_REMAINDER=true
# Как часто сверять подписки с панелью. Сверка — страховка после сбоя панели,
# а не основной путь выдачи доступа, поэтому четыре прогона в сутки.
RECONCILE_INTERVAL_HOURS=6

# --- Оплата и коммерческие правила ---
# Реквизиты выдаёт личный кабинет YooKassa. Оставьте обе строки пустыми, если
# на этом стенде доступны только Telegram Stars; заполнять можно только парой.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
# Привязка карты без списания доступна не всякому магазину: её подключает
# менеджер YooKassa. Пока не подключена — кнопка привязки не показывается.
YOOKASSA_ZERO_AMOUNT_BINDING=false
# Реферер получает max(1, floor(купленные_дни * процент / 100)). first —
# только за первую покупку приглашённого, every — за каждую.
REFERRAL_REWARD_PERCENT=10
REFERRAL_REWARD_MODE=first
YOOKASSA_ORDER_TTL_MINUTES=30
STARS_ORDER_TTL_MINUTES=15
# Три попытки YooKassa: за 24 часа до срока, затем через 6 и 12 часов после
# предыдущей попытки (expiry-relative: -24, -18, -6).
# Pydantic читает кортеж из JSON-массива.
AUTO_RENEW_OFFSETS_HOURS=[-24, -18, -6]
AUTO_RENEW_DISABLE_AFTER_FINAL_FAILURE=true

# --- Секреты приложения ---
# Каждую строку сгенерировать отдельно: openssl rand -hex 32
JWT_SECRET=
# Общий только API и server-side Next HMAC-ключ. Он подписывает короткое
# HttpOnly-утверждение для pre-render гейта /admin и не является API-токеном.
ADMIN_ASSERTION_SECRET=
ENCRYPTION_KEY=

# --- Сессии ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# От 60 до 900 секунд. Пять минут ограничивают время, на которое UI может
# помнить роль; API всегда проверяет роль заново.
ADMIN_ASSERTION_TTL_SECONDS=300

# --- Роли ---
# Идентификаторы Telegram админов через запятую. Роль поднимается при входе,
# факт пишется в audit_log. Свой ID можно узнать у @userinfobot.
ADMIN_TELEGRAM_IDS=

# --- Вход через Telegram в браузере ---
# Выдаёт мини-приложение @BotFather: Bot Settings → Web Login. Через обычный
# чат этот раздел недоступен. Пустой TELEGRAM_OIDC_CLIENT_ID означает, что
# кнопка «Войти через Telegram» на странице входа не показывается.
# Переключение бота на OpenID Connect в BotFather необратимо — см.
# docs/deployment.md.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# --- Почта ---
# log — письма только в журнал (локальная разработка без SMTP). Ссылку
#   подтверждения видно в `docker compose logs -f worker` при LOG_LEVEL=DEBUG.
# smtp — реальная отправка. Локально удобно поднять Mailpit:
#   docker compose --profile dev up -d mailpit
#   EMAIL_SENDER=smtp, SMTP_HOST=mailpit, SMTP_PORT=1025, письма на http://localhost:8025
# Сквозные тесты этот файл не читают: у них своё окружение и свой Mailpit,
# см. frontend/apps/web/e2e/stack.env.
EMAIL_SENDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org
SMTP_STARTTLS=true

# --- Публичные адреса ---
PUBLIC_WEB_URL=https://example.org
PUBLIC_APP_URL=https://example.org/app

# --- Локализация ---
DEFAULT_LANGUAGE=ru
